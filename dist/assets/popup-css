@import "https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap";*,:before,:after{box-sizing:border-box;margin:0;padding:0;font-family:Nunito,sans-serif}:root{--navy:#060d1a;--navy-mid:#0a1628;--navy-light:#0f2040;--aqua:#00c8ff;--aqua-glow:#00c8ff40;--aqua-faint:#00c8ff12;--amber:#ffb347;--amber-glow:#ffb34740;--danger:#ff4d6d;--danger-glow:#ff4d6d40;--safe:#00e5a0;--safe-glow:#00e5a040;--glass-bg:#0a1628bf;--glass-border:#00c8ff1f;--blur:14px}body{background:var(--navy);color:#fff;width:420px;min-height:580px;overflow:hidden auto}.aero-bg{z-index:0;opacity:.18;pointer-events:none;background-image:url(/assets/aero-bg.jpg);background-position:50%;background-size:cover;position:fixed;inset:0}.aero-overlay{z-index:0;pointer-events:none;background:radial-gradient(70% 50% at 15% 15%,#00c8ff1f 0%,#0000 60%),radial-gradient(50% 70% at 85% 85%,#0050b426 0%,#0000 60%),linear-gradient(#060d1a 0%,#080f1e 100%);animation:10s ease-in-out infinite alternate aero-breathe;position:fixed;inset:0}@keyframes aero-breathe{0%{opacity:.9}to{opacity:1}}.glass{background:var(--glass-bg);-webkit-backdrop-filter:blur(var(--blur));border:1px solid var(--glass-border);border-radius:14px;position:relative;overflow:hidden}.glass:before{content:"";background:linear-gradient(90deg,#0000,#00c8ff66,#0000);border-radius:100%;height:1px;position:absolute;top:0;left:10%;right:10%}.glow-aqua{box-shadow:0 0 24px var(--aqua-glow), 0 0 48px #00c8ff14}.glow-amber{box-shadow:0 0 24px var(--amber-glow)}.glow-danger{box-shadow:0 0 24px var(--danger-glow)}.glow-safe{box-shadow:0 0 24px var(--safe-glow)}@keyframes spin{0%{transform:rotate(0)}to{transform:rotate(360deg)}}@keyframes sentinel-pulse{0%,to{opacity:1;transform:scale(1)}50%{opacity:.55;transform:scale(.97)}}.pulse{animation:2.2s ease-in-out infinite sentinel-pulse}::-webkit-scrollbar{width:3px}::-webkit-scrollbar-track{background:0 0}::-webkit-scrollbar-thumb{background:var(--aqua-glow);border-radius:4px}button{cursor:pointer;background:0 0;border:none;font-family:Nunito,sans-serif}textarea{resize:none;outline:none;font-family:Nunito,sans-serif}
